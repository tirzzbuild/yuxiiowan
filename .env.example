# Server-only variables in Vercel Project Settings > Environment Variables.
# Never prefix secrets with NEXT_PUBLIC_ or expose them in index.html.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
AXZYEDEV_BASE_URL=https://axzy.my.id
AXZYEDEV_API_KEY=PUT_ROTATED_AXZYEDEV_KEY_HERE
# Optional. Set to the exact production origin if browser calls are cross-origin.
# For this same-origin Vercel deployment, leave blank.
ALLOWED_ORIGIN=
